# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urban_flood_db
DB_USER=postgres
DB_PASSWORD=
# Prefer one explicit URL. Values inside this URL are not shell-expanded automatically.
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=3
# Development only. Production must set this to false and configure PostgreSQL/PostGIS.
ALLOW_SQLITE_FALLBACK=true
FORECAST_DB_PATH=data/runtime/forecasts.sqlite3
FORECAST_ASSETS_PATH=data/runtime/runs

# Rainfall ingestion. Official feeds require a provider-approved URL/token.
RAINFALL_PRIMARY_PROVIDER=open_meteo
RAINFALL_OFFICIAL_FEED_URL=
RAINFALL_OFFICIAL_FEED_TOKEN=
RAINFALL_STORE_PATH=data/runtime/rainfall
RAINFALL_STALE_AFTER_MINUTES=30
RAINFALL_HTTP_TIMEOUT_SECONDS=8

# Road routing. Keep the two comma-separated compatible OSRM endpoints unless
# your deployment provides a managed/self-hosted OSRM endpoint.
OSRM_BASE_URLS=https://router.project-osrm.org,https://routing.openstreetmap.de/routed-car
OSRM_TIMEOUT_SECONDS=4

# API Keys & Services
OPENWEATHER_API_KEY=
MAPBOX_TOKEN=your_mapbox_token_here

# Validated high-resolution terrain (leave blank to fail closed)
TERRAIN_MANIFEST_PATH=
PILOT_AOI_PATH=data/pilot/hindmata_dadar_aoi.geojson
# Civic services: set a random token of at least 32 characters for admin API access.
# Never place this token in frontend source or version control.
MUNICIPAL_API_TOKEN=
OPERATIONS_DB_PATH=data/runtime/operations.sqlite3
